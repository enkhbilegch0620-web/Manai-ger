# Энэ файлыг .env.local нэрээр хуулаад утгуудыг бөглөнө. .env.local нь git руу орохгүй.
# Утгуудыг Supabase → Project Settings → API хэсгээс авна (Гишүүн 2-оос асууна).
# Хоосон үлдээвэл апп lib/mock-data.ts-ийн туршилтын өгөгдлөөр ажиллана.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ Зөвхөн сервер дээр. Git руу, чат руу хэзээ ч бүү хуулаарай.
# Vercel дээр Environment Variables хэсэгт нэмнэ.
SUPABASE_SERVICE_ROLE_KEY=
